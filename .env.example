# ============================================================
# SUPABASE (required)
# Get these from: Supabase Dashboard > Project Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY — never exposed to the browser. Used for order creation,
# stock updates, order tracking, and admin receipt access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# APP URL (required)
# Used to build Paystack callback URLs and the sitemap.
# Set to your Vercel/production domain once deployed.
# ============================================================
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================================
# PAYSTACK (optional — leave blank until your account is verified)
# Get these from: Paystack Dashboard > Settings > API Keys & Webhooks
# Until PAYSTACK_SECRET_KEY is set, the "Online Payment" option will
# show a friendly "not configured yet" message instead of pretending
# to work. Bank Transfer and Pay on Delivery work with no setup.
# ============================================================
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ============================================================
# WHATSAPP (optional fallback)
# The live WhatsApp number is normally managed in Admin > Settings
# once the site is running. This env var is only used as a fallback
# before store_settings has been configured.
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=2347041629846
